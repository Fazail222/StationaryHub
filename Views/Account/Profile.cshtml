@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}
<div class="mx-auto max-w-xl rounded-lg border border-white/10 bg-white/5 p-6">
    <h1 class="text-3xl font-black">Profile</h1>
    <p class="mt-2 text-gray-400">@Model.Email</p>
    <form class="mt-6 space-y-4" method="post">
        <input type="hidden" asp-for="Email" />
        <input class="field" asp-for="FullName" />
        <span asp-validation-for="FullName" class="text-sm text-gray-300"></span>
        <input class="field" asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber" class="text-sm text-gray-300"></span>
        <div class="flex gap-3">
            <button class="rounded-lg bg-white px-5 py-3 font-bold text-black hover:bg-gray-300">Save profile</button>
            <a class="rounded-lg border border-white/10 px-5 py-3 font-bold" asp-action="ChangePassword">Change password</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
