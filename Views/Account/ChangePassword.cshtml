@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}
<div class="mx-auto max-w-md rounded-lg border border-white/10 bg-white/5 p-6">
    <h1 class="text-3xl font-black">Change password</h1>
    <form class="mt-6 space-y-4" method="post">
        <div asp-validation-summary="ModelOnly" class="text-sm text-gray-300"></div>
        <input class="field" asp-for="CurrentPassword" placeholder="Current password" />
        <input class="field" asp-for="NewPassword" placeholder="New password" />
        <input class="field" asp-for="ConfirmPassword" placeholder="Confirm password" />
        <button class="w-full rounded-lg bg-white py-3 font-bold text-black hover:bg-gray-300">Update password</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
