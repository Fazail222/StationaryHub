@model IEnumerable<Product>
@{
    ViewData["Title"] = "Manage Products";
    var search = ViewData["Search"] as string;
}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-4xl font-black">Products</h1>
    <a class="rounded-lg bg-white px-5 py-3 font-bold text-black" asp-action="Create">Create product</a>
</div>
<form class="mb-6 grid gap-3 rounded-lg border border-white/10 bg-white/5 p-4 md:grid-cols-[1fr_auto_auto]" method="get">
    <input class="field" name="search" value="@search" placeholder="Search by name, category, or description" />
    <button class="rounded-lg bg-white px-5 py-3 font-bold text-black hover:bg-gray-300" type="submit">Search</button>
    <a class="rounded-lg border border-white/10 px-5 py-3 text-center font-bold hover:bg-white/10" asp-action="Index">Clear</a>
</form>
<div class="overflow-hidden rounded-lg border border-white/10 bg-white/5">
    <table class="w-full text-left text-sm">
        <thead class="bg-white/5 text-gray-400"><tr><th class="p-4">Name</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr class="border-t border-white/10">
                <td class="p-4">@p.Name</td><td>@p.Category?.Name</td><td>$@p.Price.ToString("0.00")</td><td>@p.StockQuantity</td>
                <td class="flex gap-3 p-4"><a class="text-white" asp-action="Edit" asp-route-id="@p.Id">Edit</a><form asp-action="Delete" asp-route-id="@p.Id" method="post"><button class="text-gray-300">Delete</button></form></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr class="border-t border-white/10">
                <td class="p-4 text-gray-400" colspan="5">No products found.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
