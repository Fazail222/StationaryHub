@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders";
}
<h1 class="mb-6 text-4xl font-black">Order history</h1>
<div class="overflow-hidden rounded-lg border border-white/10 bg-white/5">
    <table class="w-full text-left text-sm">
        <thead class="bg-white/5 text-gray-400"><tr><th class="p-4">Order</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr class="border-t border-white/10">
                <td class="p-4">#@order.Id</td>
                <td>@order.OrderDate.ToLocalTime().ToString("MMM d, yyyy")</td>
                <td><span class="rounded-full bg-white/10 px-3 py-1 text-white">@order.Status</span></td>
                <td>$@order.TotalAmount.ToString("0.00")</td>
                <td><a class="text-white" asp-action="Details" asp-route-id="@order.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
